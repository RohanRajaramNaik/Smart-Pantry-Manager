<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_card_gap"
    style="@style/AppCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_row_padding">

        <TextView
            android:id="@+id/ingredientText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/TextBody" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_medium"
            android:paddingStart="@dimen/tag_padding_x"
            android:paddingTop="@dimen/tag_padding_y"
            android:paddingEnd="@dimen/tag_padding_x"
            android:paddingBottom="@dimen/tag_padding_y"
            style="@style/TextPill" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
